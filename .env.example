# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# The factory reads the key from the process environment; it is never written
# to disk, never logged, and never forwarded to subprocesses or MCP servers.

# --- required for the real model -------------------------------------------
MISTRAL_API_KEY=

# --- optional ---------------------------------------------------------------
# Base URL for the OpenAI-compatible endpoint (default: Mistral).
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Which factory to boot (dir under factories/). Default: sandbox.
# MF_FACTORY=sandbox

# Port for the shell. Default comes from factory.config.ts.
# MF_PORT=4960

# 1 = deterministic fake provider: no network, no spend. Good for demos/tests.
# MF_FAKE=1

# 1 = enable shell.exec. It still requires human approval before running.
# MF_SHELL=1

# Summarize tool calls every N (0 disables; saves tokens, loses the one-line feed).
# MF_TOOL_SUMMARY_EVERY=3

# Route tiers C/D to a cheaper model. UNSET by default: every tier uses
# deepseek-v4-1-flash-1017. See DECISIONS.md D-001 for the cost note.
# MF_CHEAP_MODEL=ministral-3b-latest
