{
  "name": "meta-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @mf/core --filter @mf/harness-notes --filter @mf/harness-coding --filter @mf/harness-pages --filter @mf/harness-subagents --filter @mf/harness-proactive --filter @mf/harness-teams --filter @mf/harness-mailbox --filter @mf/harness-skills-bridge run build && pnpm --filter @mf/app dev",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
